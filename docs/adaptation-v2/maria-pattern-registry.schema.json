{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maria V2 pattern registry",
  "type": "object",
  "required": ["schemaVersion", "registryVersion", "policy", "patterns"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryVersion": { "type": "string" },
    "policy": {
      "type": "object",
      "required": [
        "sharedSourcesAreImmutable",
        "projectsUseFrozenLocalCopies",
        "brandComponentsRemainSeparate",
        "realProjectsRequireApproved"
      ]
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "kind",
          "status",
          "autoEligible",
          "intensity",
          "maxPerReel",
          "fallback",
          "packagePath"
        ]
      }
    }
  }
}
