{
  "schemaVersion": 1,
  "name": "María Bejarano recommended SFX palette",
  "sourceManifest": "sfx-manifest.json",
  "policy": {
    "preserveAllExistingSamples": true,
    "voiceIsPrimary": true,
    "humanListeningRequired": true,
    "fixedUniversalVolumeForbidden": true,
    "alignTransientToVisualEvent": true
  },
  "assignments": [
    {
      "event": "general-transition",
      "preferred": ["swoosh"],
      "alternatives": ["swipe"],
      "startingVolumeRange": [0.08, 0.2],
      "visualAnchor": "transient lands when the new layout becomes readable"
    },
    {
      "event": "pip-llamada",
      "preferred": ["whoosh-tuck"],
      "alternatives": [],
      "startingVolumeRange": [0.08, 0.18],
      "visualAnchor": "transient lands when María settles in the call window"
    },
    {
      "event": "side-panel-or-capture",
      "preferred": ["swipe"],
      "alternatives": ["swoosh"],
      "startingVolumeRange": [0.08, 0.18],
      "visualAnchor": "transient follows the directional panel landing"
    },
    {
      "event": "interface-action",
      "preferred": ["click"],
      "alternatives": [],
      "startingVolumeRange": [0.06, 0.16],
      "visualAnchor": "transient matches the exact UI state change"
    },
    {
      "event": "small-icon-or-item",
      "preferred": ["telop"],
      "alternatives": ["pop"],
      "startingVolumeRange": [0.05, 0.14],
      "visualAnchor": "transient matches the item reveal, not the start of its approach"
    },
    {
      "event": "conclusion-or-card-land",
      "preferred": ["impact-soft"],
      "alternatives": ["thud"],
      "startingVolumeRange": [0.08, 0.18],
      "visualAnchor": "transient lands when the conclusion/card locks in place"
    },
    {
      "event": "positive-result-or-cta",
      "preferred": ["chime"],
      "alternatives": ["ding"],
      "startingVolumeRange": [0.05, 0.14],
      "visualAnchor": "transient supports the result or confirmed CTA state"
    },
    {
      "event": "screenshot-or-proof",
      "preferred": ["camera-shutter"],
      "alternatives": ["shutter-release"],
      "startingVolumeRange": [0.06, 0.16],
      "visualAnchor": "transient matches capture/reveal of the evidence"
    },
    {
      "event": "problem-or-alert",
      "preferred": ["subtle-warning"],
      "alternatives": [],
      "startingVolumeRange": [0.05, 0.14],
      "visualAnchor": "transient marks the problem without overpowering speech"
    }
  ]
}
